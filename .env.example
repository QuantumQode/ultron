# Copy this file to `.env` and fill in your values. Never commit `.env`.

# ---------- Telegram (required) ----------
# Bot token from @BotFather
TELEGRAM_TOKEN=
# Your own Telegram user ID (message @userinfobot to get it). Everyone else is ignored.
TELEGRAM_OWNER_ID=
# Private group with Topics turned on, plus each topic's thread ID.
# Leave blank until the group exists; `/status` in each topic will show the IDs.
TELEGRAM_GROUP_ID=
TELEGRAM_TOPIC_CHAT=
TELEGRAM_TOPIC_REFLECT=
TELEGRAM_TOPIC_BRIEFS=

# ---------- Claude (required) ----------
# From https://console.anthropic.com
ANTHROPIC_API_KEY=
# MODEL_FAST=claude-haiku-5-5
# MODEL_SMART=claude-sonnet-5-5
# Monthly API spend cap in USD (warning at 80%, essential jobs only at 100%)
MONTHLY_COST_CAP_USD=20

# ---------- Notion (phase 2) ----------
# Integration token from https://www.notion.so/my-integrations
NOTION_TOKEN=
# ID of the empty "Ultron" page you shared with the integration (from its URL)
NOTION_ROOT_PAGE_ID=

# ---------- Yahoo Mail, read-only (phase 3) ----------
YAHOO_USER=
# Yahoo Account Security -> Generate app password
YAHOO_APP_PASSWORD=
# Comma-separated senders or domains Ultron must never read, e.g. mybank.co.uk,nhs.net
EMAIL_BLOCKLIST=

# ---------- iCloud Calendar (phase 4) ----------
# Your Apple ID email
ICLOUD_USER=
# appleid.apple.com -> Sign-In and Security -> App-Specific Passwords
ICLOUD_APP_PASSWORD=
ICLOUD_CALENDAR_NAME=Ultron

# ---------- Schedule ----------
TZ=Europe/London
MORNING_BRIEF_TIME=07:30
EVENING_REVIEW_TIME=21:30
# 21:00: suggestions for tomorrow + "what are your priorities?" (one nudge 45 min later)
NIGHTLY_TIME=21:00
NIGHTLY_NUDGE_MINUTES=45
# "How's the day going?" check-in (set MIDDAY_CHECKIN=false to turn it off)
MIDDAY_CHECKIN=true
MIDDAY_CHECKIN_TIME=13:00
WEEKLY_REVIEW_DAY=sun
WEEKLY_REVIEW_TIME=19:00
QUIET_HOURS_START=22:30
QUIET_HOURS_END=07:00

# ---------- Storage ----------
DB_PATH=data/ultron.db
# Nightly backups (database + Notion pages as JSON), one dated folder per night
BACKUP_DIR=backups
BACKUP_TIME=03:30
BACKUP_KEEP_DAYS=14
